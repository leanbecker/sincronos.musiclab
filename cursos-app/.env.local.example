# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Nunca la expongas en el cliente. Solo se usa en el webhook y en la captura de pagos (server-side).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Mercado Pago — Tus integraciones > Credenciales de producción (o de prueba)
MP_ACCESS_TOKEN=tu-access-token

# PayPal — developer.paypal.com/dashboard > tu app > Client ID y Secret
# Mientras probás, dejá PAYPAL_API_BASE en sandbox. Para producción, cambiala a:
# https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=tu-client-id
PAYPAL_CLIENT_SECRET=tu-client-secret

# URL pública de tu sitio (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave secreta para dar de alta instructores desde /instructor/alta
# Inventá una clave larga y difícil de adivinar (no la compartas por canales públicos).
INSTRUCTOR_SIGNUP_SECRET=elegí-una-clave-larga-y-secreta
